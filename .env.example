# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Supabase (see lib/supabase.js, lib/queries.js) — the only backend this
# app talks to. Never add a service-role key here; that belongs only in
# the separate admin app's server-side environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
